# Copy this file to .env and fill in real values before running the server.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost/school_db

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# This MUST be set. The server will refuse to start without it.
SECRET_KEY=replace_with_a_long_random_string

# Comma-separated origins allowed to call the API (dev frontend defaults)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Credentials for the auto-seeded first admin account (created only when the
# users table is empty). If ADMIN_INITIAL_PASSWORD is omitted, a random
# password is generated and printed once in the server log — there is no
# hardcoded default. Change the password immediately after first login.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Break-glass admin recovery: if the admin is locked out, set this and restart
# the server — the admin password is reset to this value and portal access is
# re-enabled. REMOVE the variable immediately after logging back in.
# ADMIN_RECOVERY_PASSWORD=

# ── SMS via Africa's Talking (https://africastalking.com) ────────────────────
# Without AT_API_KEY, SMS sending is skipped (logged only). To send real SMS:
# 1. Create an Africa's Talking account and an app, top up SMS credits
# 2. Set the live API key and username below (AT_USERNAME "sandbox" is test-only)
# 3. Optionally register an alphanumeric sender ID (e.g. BONASCHOOL) with them
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# Periodic database snapshots (JSON, downloadable by the system admin only)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# BACKUP_DIR=backend/backups
