# Copy this file to .env and fill in real values before running the server.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost/bona_school_db

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# This MUST be set. The server will refuse to start without it.
SECRET_KEY=replace_with_a_long_random_string

# Initial passwords for seeded users (used by POST /api/auth/setup-users on first run)
# Delete these lines after seeding and change all passwords immediately.
ADMIN_INITIAL_PASSWORD=ChangeMe@1234
PRINCIPAL_INITIAL_PASSWORD=ChangeMe@1234
ACCOUNTANT_INITIAL_PASSWORD=ChangeMe@1234
